# slack-closet — SQLite backed key/value store for Slack data
#
# Tables:
#   - users
#   - channels
#   - messages
#   - message_threads
#
# Key rules:
#   - users: arbitrary text, but not matching channel/message/thread patterns
#   - channels: must start with "#"
#   - messages: must match p1785610939026309
#   - message_threads: must match p1785610939026309:1786025723.220339
#
# Value rules:
#   - users/channels: plain strings
#   - messages/message_threads: JSON text, validated with jq
#
# Commands:
#   init
#   put <key> <value>
#   upsert <table> <key> <value>
#   get <key>
#   get-all <key>
#   del <key>
#   list [all|users|channels|messages|message_threads]
#   search <key_regex> [value_regex]
#
# Notes:
#   - put auto-selects table from key
#   - get auto-searches the matching table
#   - get-all searches all tables
#   - search always searches all tables
#   - added_at stays fixed on first insert
#   - updated_at changes on updates
#
# A word of advice:
#   An LLM wrote this script. It's wise to learn jq and use it to filter the
#   JASON output which this script spews, for acheiving anything productive
#   in the shell. Stay hydrated. Also, pants are not the only bottom wear.
#
# xoxd-ZGF0YWJhc2VzIGFyZSBub3QgYXQgYWxsIGJhc2Vk
#

# Murphy's Law
set -euo pipefail

DB="$(dirname $(realpath ${BASH_SOURCE[0]}))/${DB:-slack-closet-actual.sqlite3}"

sql_quote() {
  local s="$1"
  s=${s//\'/\'\'} && printf "'%s'" "$s"
}

# seequel-light imples lots of seequels

init_db() {
  sqlite3 "$DB" <<'SQL' >/dev/null
PRAGMA journal_mode=WAL;

CREATE TABLE IF NOT EXISTS users (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  added_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
);

CREATE TABLE IF NOT EXISTS channels (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  added_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
);

CREATE TABLE IF NOT EXISTS messages (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  added_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
);

CREATE TABLE IF NOT EXISTS message_threads (
  key TEXT PRIMARY KEY,
  value TEXT NOT NULL,
  added_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now')),
  updated_at TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ','now'))
);
SQL
}

# organization multiplies productivity

table_for_key() {
  local key="$1"
  if [[ "$key" =~ ^#.+$ ]]; then
    echo channels
  elif [[ "$key" =~ ^p[0-9]+:[0-9]+\.[0-9]+$ ]]; then
    echo message_threads
  elif [[ "$key" =~ ^p[0-9]+$ ]]; then
    echo messages
  else
    echo users
  fi
}

validate_key_for_table() {
  local table="$1" key="$2"
  case "$table" in
    users) [[ "$key" != \#* && "$key" != p* ]] ;;
    channels) [[ "$key" =~ ^#.+$ ]] ;;
    messages) [[ "$key" =~ ^p[0-9]+$ ]] ;;
    message_threads) [[ "$key" =~ ^p[0-9]+:[0-9]+\.[0-9]+$ ]] ;;
    *) return 1 ;;
  esac
}

validate_json_if_needed() {
  local table="$1" value="$2"
  case "$table" in
    messages|message_threads)
      command -v jq >/dev/null 2>&1 || { echo "jq is required for JSON validation" >&2; exit 1; }
      printf '%s' "$value" | jq -e . >/dev/null
      ;;
  esac
}

# seequel beach

upsert_kv() {
  local table="$1" key="$2" value="$3"

  validate_key_for_table "$table" "$key" || { echo "invalid key for $table: $key" >&2; exit 1; }
  validate_json_if_needed "$table" "$value"

  sqlite3 "$DB" <<SQL
INSERT INTO $table (key, value)
VALUES ($(sql_quote "$key"), $(sql_quote "$value"))
ON CONFLICT(key) DO UPDATE SET
  value = excluded.value,
  updated_at = strftime('%Y-%m-%dT%H:%M:%fZ','now');
SQL
}

# seequel again

get_one() {
  local table="$1" key="$2"
  sqlite3 -json "$DB" <<SQL
SELECT '$table' AS table_name, key, value, added_at, updated_at
FROM $table
WHERE key = $(sql_quote "$key");
SQL
}

get_all() {
  local key="$1"
  sqlite3 -json "$DB" <<SQL
SELECT 'users' AS table_name, key, value, added_at, updated_at FROM users WHERE key = $(sql_quote "$key")
UNION ALL
SELECT 'channels' AS table_name, key, value, added_at, updated_at FROM channels WHERE key = $(sql_quote "$key")
UNION ALL
SELECT 'messages' AS table_name, key, value, added_at, updated_at FROM messages WHERE key = $(sql_quote "$key")
UNION ALL
SELECT 'message_threads' AS table_name, key, value, added_at, updated_at FROM message_threads WHERE key = $(sql_quote "$key");
SQL
}

del_kv() {
  local table="$1" key="$2"
  sqlite3 "$DB" <<SQL
DELETE FROM $table WHERE key = $(sql_quote "$key");
SQL
}

# moar seequels

list_table() {
  local table="$1"
  sqlite3 -json "$DB" <<SQL
SELECT '$table' AS table_name, key, value, added_at, updated_at
FROM $table
ORDER BY key;
SQL
}

list_all() {
  sqlite3 -json "$DB" <<'SQL'
SELECT 'users' AS table_name, key, value, added_at, updated_at FROM users
UNION ALL
SELECT 'channels' AS table_name, key, value, added_at, updated_at FROM channels
UNION ALL
SELECT 'messages' AS table_name, key, value, added_at, updated_at FROM messages
UNION ALL
SELECT 'message_threads' AS table_name, key, value, added_at, updated_at FROM message_threads
ORDER BY table_name, key;
SQL
}

search_all() {
  local key_regex="$1" value_regex="${2:-}"
  if [[ -n "${value_regex:-}" ]]; then
    sqlite3 -json "$DB" <<'SQL' | jq -c --arg re "$key_regex" --arg vre "$value_regex" '
      .[]
      | select(.key | test($re))
      | select(.value | test($vre))
    '
SELECT 'users' AS table_name, key, value, added_at, updated_at FROM users
UNION ALL
SELECT 'channels' AS table_name, key, value, added_at, updated_at FROM channels
UNION ALL
SELECT 'messages' AS table_name, key, value, added_at, updated_at FROM messages
UNION ALL
SELECT 'message_threads' AS table_name, key, value, added_at, updated_at FROM message_threads;
SQL
  else
    sqlite3 -json "$DB" <<'SQL' | jq -c --arg re "$key_regex" '
      .[]
      | select(.key | test($re))
    '
SELECT 'users' AS table_name, key, value, added_at, updated_at FROM users
UNION ALL
SELECT 'channels' AS table_name, key, value, added_at, updated_at FROM channels
UNION ALL
SELECT 'messages' AS table_name, key, value, added_at, updated_at FROM messages
UNION ALL
SELECT 'message_threads' AS table_name, key, value, added_at, updated_at FROM message_threads;
SQL
  fi
}

# finally some shell scripting

usage() {
  sed -n '1,40p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  init_db
  case "${1:-}" in
    init)
      ;;
    put)
      upsert_kv "$(table_for_key "$2")" "$2" "$3"
      ;;
    upsert)
      upsert_kv "$2" "$3" "$4"
      ;;
    get)
      get_one "$(table_for_key "$2")" "$2"
      ;;
    get-all)
      get_all "$2"
      ;;
    del)
      del_kv "$(table_for_key "$2")" "$2"
      ;;
    list)
      case "${2:-all}" in
        all) list_all ;;
        users|channels|messages|message_threads) list_table "$2" ;;
        *) echo "invalid table: $2" >&2; exit 1 ;;
      esac
      ;;
    search)
      search_all "$2" "${3:-}"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
